*.tmp
*.temp
*.bak
*.orig
*.html
results.html
paper/qa_*.png
artifacts/paper_page*.png
artifacts/paper_final_audit_page*.png

# Experiment tracker/local training outputs
wandb/
mlruns/
runs/
lightning_logs/
