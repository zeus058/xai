# Keep paper/result figures that are part of the evidence package.
!paper/figures/*.png
!results/locked_final/**/figures/*.png

# Python/runtime cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.agents/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# LaTeX build intermediates
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz

